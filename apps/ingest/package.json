{
  "name": "@elessar/ingest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Long-running ingest worker: polls sources, enriches, correlates, detects anomalies.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
