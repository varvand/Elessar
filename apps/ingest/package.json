    "lint": "eslint src"
  },
  "dependencies": {
    "@elessar/connectors": "workspace:*",
    "@elessar/core": "workspace:*",
    "@elessar/db": "workspace:*",
    "@elessar/ml": "workspace:*",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.23.12",
    "typescript": "5.9.3"
  }
}
