# ---------------------------------------------------------------------------
# Elessar configuration. Copy to `.env` and adjust.
# Every source Elessar ships with works with NO API key. The keyed sources
# below are strictly optional and stay disabled when their key is absent.
# ---------------------------------------------------------------------------

# Postgres 17 + pgvector. Matches infra/docker-compose.yml defaults.
DATABASE_URL=postgres://elessar:elessar@localhost:5433/elessar

# trace | debug | info | warn | error
ELESSAR_LOG_LEVEL=info

# Sent on every outbound request. Several public APIs (api.weather.gov, GDELT)
# ask for a contact address and will throttle or reject generic agents.
ELESSAR_USER_AGENT="Elessar/0.1 (+https://github.com/your-org/elessar; you@example.com)"

# Where transformers.js caches the ONNX embedding model (~90 MB, first run only).
ELESSAR_MODEL_CACHE=./data/models

# --- Optional, keyed sources -----------------------------------------------
# NASA FIRMS active-fire detections. Free key: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# ReliefWeb requires a registered appname: https://apidoc.reliefweb.int/parameters#appname
RELIEFWEB_APPNAME=

# --- Web app ---------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=Elessar
